<?xml version="1.0" encoding="utf-8"?>
<!--
  One screen, two feature cards. Media and captions are independent services, so each
  gets its own framed card and neither implies the other. The frame also carries the
  trust story: the microphone permission belongs to the Captions card alone, and that
  card plainly says whether it is off.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="Media Bridge"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:lineSpacingMultiplier="1.25"
            android:paddingTop="6dp"
            android:text="A helper for TakeMotions glasses apps. Everything it serves stays on this phone."
            android:textSize="12sp" />

        <!-- ==== Media ============================================================ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="26dp"
            android:paddingBottom="8dp"
            android:text="Media"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/info_box"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.25"
                android:text="Shows what's playing and lets the glasses control it from the ring — play / pause / next / previous / volume."
                android:textSize="12sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/mediaSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="10dp"
                android:text="Enable media bridge"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/accessText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notification access: not granted — tap below"
                android:textSize="13sp" />

            <Button
                android:id="@+id/grantAccessBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Grant notification access" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:paddingTop="16dp"
                android:paddingBottom="6dp"
                android:text="Now playing"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/nowPlayingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/inner_box"
                android:lineSpacingMultiplier="1.2"
                android:padding="12dp"
                android:text="Bridge off"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:lineSpacingMultiplier="1.25"
                android:paddingTop="10dp"
                android:text="Playback is controlled from the glasses (ring), not here."
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ==== Captions ========================================================= -->
        <!-- Same switch shape as Media, but it means "running now", not a remembered
             setting: Android grants capture one session at a time, from a visible
             activity, so turning it on always prompts and a restart always turns it
             off (the card says so). Hidden below Android 12 (captionUnsupported). -->

        <LinearLayout
            android:id="@+id/captionSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="26dp"
                android:paddingBottom="8dp"
                android:text="Captions"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/info_box"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.25"
                    android:text="Turns English speech in whatever is playing into text for the glasses app. Everything runs on this phone. Android asks permission each time — that permission is how it hands over the playback sound; no video is used and nothing is saved."
                    android:textSize="12sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/captionSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingBottom="10dp"
                    android:text="Enable captions"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/captionStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.2"
                    android:paddingTop="10dp"
                    android:text="Off"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/captionPreviewText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/inner_box"
                    android:lineSpacingMultiplier="1.2"
                    android:padding="12dp"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.6"
                    android:lineSpacingMultiplier="1.25"
                    android:paddingTop="10dp"
                    android:text="Unlike the media bridge, this switches itself off when the phone restarts — Android hands over the sound one session at a time."
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/captionUnsupported"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:lineSpacingMultiplier="1.25"
            android:paddingTop="26dp"
            android:text="Captions need Android 12 or newer. Everything above works as usual on this phone."
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- ==== Privacy ========================================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="30dp"
            android:paddingBottom="6dp"
            android:text="Privacy"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.3"
            android:text="Media Bridge only detects which media app is playing. Android requires &quot;Notification access&quot; to do that, but this app never reads, stores, or sends your notifications or messages — the notification listener it registers does nothing. The info is served only to 127.0.0.1 (loopback) on your own device."
            android:textSize="12sp" />

        <TextView
            android:id="@+id/captionPrivacyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.3"
            android:paddingTop="12dp"
            android:text="Captions ask for the microphone permission, but the microphone is never opened. Android routes captured playback sound through the same permission, and the capture only lasts while captions are running, with the notification showing. The audio is transcribed on this phone, is never written to a file, and the text is served only to 127.0.0.1 — same as everything else here."
            android:textSize="12sp" />

        <Button
            android:id="@+id/appSettingsBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="App info / revoke access" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.5"
            android:gravity="center"
            android:paddingTop="28dp"
            android:text="TakeMotions · @r_tkbyc"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
